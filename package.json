{
  "name": "app-socios",
  "private": true,
  "version": "0.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "artifact:js": "esbuild src/main.jsx --bundle --loader:.jsx=jsx --minify --charset=ascii --define:process.env.NODE_ENV='\"production\"' --outfile=dist/bundle.js",
    "artifact:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o dist/out.css --minify",
    "artifact": "npm run artifact:js && npm run artifact:css && python3 scripts/build_html.py",
    "icones": "node scripts/gerar_icones.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "esbuild": "0.23.1",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4.13"
  }
}
